<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="NeedyNest"
         connectionString="Data Source=LAPTOP-MSIETGV1\SQLEXPRESS;Initial Catalog=NeedyNest;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <!-- Email notifications: leave SmtpHost blank to disable. For Gmail use
       smtp.gmail.com / 587 / an App Password (not your normal password). -->
  <appSettings>
    <add key="SmtpHost" value="" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="" />
    <add key="SmtpPassword" value="" />
    <add key="SmtpFrom" value="" />
    <add key="SmtpSsl" value="true" />
  </appSettings>
</configuration>
